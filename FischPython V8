    def draw_bestiary(self):
        bx, by = SCREEN_WIDTH // 2 - 380, SCREEN_HEIGHT // 2 - 230
        bw, bh = 760, 460
        pygame.draw.rect(screen, DARK_GRAY, (bx, by, bw, bh), border_radius=12)
        pygame.draw.rect(screen, CYAN, (bx, by, bw, bh), width=3, border_radius=12)

        close_btn = pygame.Rect(bx + bw - 40, by + 10, 30, 30)
        pygame.draw.rect(screen, RED, close_btn, border_radius=6)
        x_lbl = font_medium.render("X", True, WHITE)
        screen.blit(x_lbl, (close_btn.centerx - x_lbl.get_width() // 2, close_btn.centery - x_lbl.get_height() // 2))

        island_keys = list(ISLANDS.keys())
        total_pages = len(island_keys) + 1
        self.bestiary_page = max(0, min(self.bestiary_page, total_pages - 1))

        current_island_key = island_keys[self.bestiary_page] if self.bestiary_page < len(island_keys) else None

        if current_island_key:
            isl_name = ISLANDS[current_island_key]["name"]
            title = font_large.render(f"BESTIÁRIO - {isl_name.upper()}", True, CYAN)
            
            page_species = []
            for lk in ISLANDS[current_island_key]["lakes"].values():
                for r_list in lk["fish"].values():
                    for fish_name in r_list:
                        if fish_name not in page_species:
                            page_species.append(fish_name)
        else:
            title = font_large.render("BESTIÁRIO - EVENTO ECLIPSE", True, RED)
            page_species = ["Eclipse Ancient Serpent"]

        screen.blit(title, (SCREEN_WIDTH // 2 - title.get_width() // 2, by + 18))

        all_species = sorted(list(get_all_game_species()))
        count_discovered = len(self.player.bestiary)
        info_lbl = font_xs.render(f"Total Descoberto: {count_discovered} / {len(all_species)}", True, WHITE)
        screen.blit(info_lbl, (bx + 25, by + 58))

        start_y = by + 90
        col_width = bw // 2
        items_per_column = math.ceil(len(page_species) / 2) if len(page_species) > 0 else 1

        for i, species in enumerate(page_species):
            col_index = i // items_per_column
            row_index = i % items_per_column

            col_x = bx + 20 + (col_index * col_width)
            cy = start_y + (row_index * 26)

            if species in self.player.bestiary:
                data = self.player.bestiary[species]
                rarity = data.get('rarity', 'Comum')
                
                if rarity not in FISH_RARITY_INFO:
                    found_rarity = "Comum"
                    for isl in ISLANDS.values():
                        for lk in isl["lakes"].values():
                            for r_name, r_list in lk["fish"].items():
                                if species in r_list:
                                    found_rarity = r_name
                                    break
                    if species == "Eclipse Ancient Serpent":
                        found_rarity = "Divina"
                    rarity = found_rarity
                
                rarity_color = FISH_RARITY_INFO.get(rarity, {}).get("color", WHITE)
                
                txt_str = f"✔ {species} [{rarity[:3]}] - {data['caught']}x | {data['max_weight']}kg"
                lbl = font_xs.render(txt_str, True, rarity_color)
            else:
                txt_str = f"❓ {species} (Não descoberto)"
                lbl = font_xs.render(txt_str, True, GRAY)
            
            screen.blit(lbl, (col_x, cy))

        btn_prev = pygame.Rect(bx + 20, by + bh - 40, 110, 30)
        btn_next = pygame.Rect(bx + bw - 130, by + bh - 40, 110, 30)
        pygame.draw.rect(screen, (60, 60, 80), btn_prev, border_radius=6)
        pygame.draw.rect(screen, (60, 60, 80), btn_next, border_radius=6)

        p_txt = font_xs.render("◄ Anterior", True, WHITE)
        n_txt = font_xs.render("Próximo ►", True, WHITE)
        screen.blit(p_txt, (btn_prev.centerx - p_txt.get_width() // 2, btn_prev.centery - p_txt.get_height() // 2))
        screen.blit(n_txt, (btn_next.centerx - n_txt.get_width() // 2, btn_next.centery - n_txt.get_height() // 2))

        page_lbl = font_xs.render(f"Página {self.bestiary_page + 1} / {total_pages}", True, WHITE)
        screen.blit(page_lbl, (SCREEN_WIDTH // 2 - page_lbl.get_width() // 2, by + bh - 32))

