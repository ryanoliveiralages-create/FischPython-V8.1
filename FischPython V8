    def save_game(self):
        try:
            data = {
                "x": self.player.x,
                "y": self.player.y,
                "coins": self.player.coins,
                "level": self.player.level,
                "xp": self.player.xp,
                "xp_next": self.player.xp_next,
                "equipped_rod": self.player.equipped_rod,
                "unlocked_rods": self.player.unlocked_rods,
                "equipped_boat": self.player.equipped_boat,
                "unlocked_boats": self.player.unlocked_boats,
                "equipped_bait": self.player.equipped_bait,
                "baits_stock": self.player.baits_stock,
                "inventory": self.player.inventory,
                "bestiary": self.player.bestiary
            }
            temp_file = SAVE_FILE + ".tmp"
            with open(temp_file, "w", encoding="utf-8") as f:
                json.dump(data, f, ensure_ascii=False, indent=2)
            if os.path.exists(SAVE_FILE):
                os.remove(SAVE_FILE)
            os.rename(temp_file, SAVE_FILE)
        except Exception as e:
            print(f"Erro ao salvar o jogo: {e}")

    def load_game(self):
        if not os.path.exists(SAVE_FILE):
            return
        try:
            with open(SAVE_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)
                self.player.x = float(data.get("x", self.player.x))
                self.player.y = float(data.get("y", self.player.y))
                self.player.coins = int(data.get("coins", self.player.coins))
                self.player.level = int(data.get("level", self.player.level))
                self.player.xp = int(data.get("xp", self.player.xp))
                self.player.xp_next = int(data.get("xp_next", self.player.xp_next))
                self.player.equipped_rod = data.get("equipped_rod", self.player.equipped_rod)
                self.player.unlocked_rods = data.get("unlocked_rods", self.player.unlocked_rods)
                self.player.equipped_boat = data.get("equipped_boat", self.player.equipped_boat)
                self.player.unlocked_boats = data.get("unlocked_boats", self.player.unlocked_boats)
                self.player.equipped_bait = data.get("equipped_bait", self.player.equipped_bait)
                self.player.baits_stock = data.get("baits_stock", self.player.baits_stock)
                
                raw_inv = data.get("inventory", [])
                for fish in raw_inv:
                    if "favorited" not in fish:
                        fish["favorited"] = False
                    if "is_shiny" not in fish:
                        fish["is_shiny"] = False
                    if "is_sparkling" not in fish:
                        fish["is_sparkling"] = False
                self.player.inventory = raw_inv

                self.player.bestiary = data.get("bestiary", self.player.bestiary)
                
                for fish_name, f_data in self.player.bestiary.items():
                    if "rarity" not in f_data or f_data["rarity"] not in FISH_RARITY_INFO:
                        found_rarity = "Comum"
                        for isl in ISLANDS.values():
                            for lk in isl["lakes"].values():
                                for r_name, r_list in lk["fish"].items():
                                    if fish_name in r_list:
                                        found_rarity = r_name
                                        break
                        if fish_name == "Eclipse Ancient Serpent":
                            found_rarity = "Divina"
                        f_data["rarity"] = found_rarity
        except Exception as e:
            print(f"Erro ao carregar o jogo: {e}")

    def spawn_eclipse_zone(self):
        zone_size = 400
        for _ in range(150):
            rx = random.randint(100, WORLD_WIDTH - zone_size - 100)
            ry = random.randint(100, WORLD_HEIGHT - zone_size - 100)
            candidate = pygame.Rect(rx, ry, zone_size, zone_size)

            intersects = False
            for isl in ISLANDS.values():
                if candidate.colliderect(isl["rect"].inflate(100, 100)):
                    intersects = True
                    break
            if not intersects:
                self.eclipse_zone = candidate
                return
        self.eclipse_zone = pygame.Rect(1200, 1200, zone_size, zone_size)

