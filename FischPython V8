    def handle_shop_click(self, pos):
        sx, sy = SCREEN_WIDTH // 2 - 280, SCREEN_HEIGHT // 2 - 250
        close_btn = pygame.Rect(sx + 515, sy + 10, 30, 30)
        if close_btn.collidepoint(pos):
            self.state = 'EXPLORING'
            return

        if self.active_shop_type == 'rod':
            isl = ISLANDS[self.current_shop_island]
            y_off = sy + 65
            for r_key, r_data in isl["rods"].items():
                btn_b = pygame.Rect(sx + 400, y_off + 5, 130, 30)
                if btn_b.collidepoint(pos):
                    is_unlocked = r_key in self.player.unlocked_rods
                    if is_unlocked:
                        self.player.equipped_rod = r_key
                        self.show_toast(f"Equipou: {r_data['name']}")
                    elif self.player.level < r_data['req_level']:
                        self.show_toast(f"Requer Nível {r_data['req_level']}!")
                    elif self.player.coins >= r_data['price']:
                        self.player.coins -= r_data['price']
                        if r_key not in self.player.unlocked_rods:
                            self.player.unlocked_rods.append(r_key)
                        self.player.equipped_rod = r_key
                        self.show_toast(f"Comprou e Equipou: {r_data['name']}")
                        self.check_masterline_unlock()
                        self.save_game()
                    else:
                        self.show_toast("Moedas insuficientes!")
                    return
                y_off += 50

            if "masterline" in self.player.unlocked_rods:
                btn_b = pygame.Rect(sx + 400, y_off + 5, 130, 30)
                if btn_b.collidepoint(pos):
                    self.player.equipped_rod = "masterline"
                    self.show_toast("Equipou: VARA MASTERLINE")
                    self.save_game()
                    return
                y_off += 50

            y_off += 40
            for b_key, b_data in BAITS.items():
                if b_key == "minhoca": continue
                btn_b = pygame.Rect(sx + 400, y_off + 5, 130, 30)
                if btn_b.collidepoint(pos):
                    if self.player.coins >= b_data['price']:
                        self.player.coins -= b_data['price']
                        self.player.baits_stock[b_key] += b_data['pack']
                        self.player.equipped_bait = b_key
                        self.show_toast(f"Comprou {b_data['name']}!")
                        self.save_game()
                    else:
                        self.show_toast("Moedas insuficientes!")
                    return
                y_off += 50

        elif self.active_shop_type == 'boat':
            y_off = sy + 80
            for b_key, b_data in BOATS.items():
                btn_b = pygame.Rect(sx + 400, y_off + 5, 130, 35)
                if btn_b.collidepoint(pos):
                    is_unlocked = b_key in self.player.unlocked_boats
                    if is_unlocked:
                        self.player.equipped_boat = b_key
                        self.show_toast(f"Equipou veículo: {b_data['name']}")
                        self.save_game()
                    elif self.player.coins >= b_data['price']:
                        self.player.coins -= b_data['price']
                        if b_key not in self.player.unlocked_boats:
                            self.player.unlocked_boats.append(b_key)
                        self.player.equipped_boat = b_key
                        self.show_toast(f"Adquiriu: {b_data['name']}!")
                        self.check_masterline_unlock()
                        self.save_game()
                    else:
                        self.show_toast("Moedas insuficientes!")
                    return
                y_off += 55

    def update_joystick(self):
        mouse_down = pygame.mouse.get_pressed()[0]
        m_pos = pygame.mouse.get_pos()

        if mouse_down:
            if not self.joystick_active:
                # Verifica se clicou na base do joystick para ativá-lo
                dist = math.hypot(m_pos[0] - self.joystick_center[0], m_pos[1] - self.joystick_center[1])
                if dist <= self.joystick_radius + 20:
                    self.joystick_active = True

            if self.joystick_active:
                dx = m_pos[0] - self.joystick_center[0]
                dy = m_pos[1] - self.joystick_center[1]
                dist = math.hypot(dx, dy)
                
                if dist <= self.joystick_radius:
                    self.joystick_pos = [float(m_pos[0]), float(m_pos[1])]
                    if dist > 0:
                        self.joystick_vector = (dx / self.joystick_radius, dy / self.joystick_radius)
                    else:
                        self.joystick_vector = (0.0, 0.0)
                else:
                    # Trava no limite do raio do joystick
                    angle = math.atan2(dy, dx)
                    self.joystick_pos[0] = self.joystick_center[0] + self.joystick_radius * math.cos(angle)
                    self.joystick_pos[1] = self.joystick_center[1] + self.joystick_radius * math.sin(angle)
                    self.joystick_vector = (math.cos(angle), math.sin(angle))
        else:
            self.joystick_active = False
            self.joystick_pos = [float(self.joystick_center[0]), float(self.joystick_center[1])]
            self.joystick_vector = (0.0, 0.0)

        # Ação touch
        self.touch_action = False
        if mouse_down and self.btn_action.collidepoint(m_pos):
            self.touch_action = True

    def run(self):
        self.run_menu()

        running = True
        while running:
            clock.tick(FPS)
            
            if pygame.time.get_ticks() >= self.weather_timer:
                self.check_weather_rotation()

            keys = pygame.key.get_pressed()
            self.update_joystick()

            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    self.save_game()
                    running = False

                if event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_SPACE:
                        self.interact()
                    elif event.key in (pygame.K_e, pygame.K_i):
                        self.state = 'EXPLORING' if self.state == 'INVENTORY' else 'INVENTORY'
                    elif event.key == pygame.K_b:
                        self.state = 'EXPLORING' if self.state == 'BESTIARY' else 'BESTIARY'
                    elif event.key == pygame.K_ESCAPE:
                        self.state = 'EXPLORING'
                    elif self.state == 'INVENTORY':
                        if event.key == pygame.K_UP:
                            self.inventory_scroll = max(0, self.inventory_scroll - 1)
                        elif event.key == pygame.K_DOWN:
                            max_scroll = max(0, len(self.player.inventory) - 9)
                            self.inventory_scroll = min(max_scroll, self.inventory_scroll + 1)

                if event.type == pygame.MOUSEWHEEL:
                    if self.state == 'INVENTORY':
                        self.inventory_scroll -= event.y
                        max_scroll = max(0, len(self.player.inventory) - 9)
                        self.inventory_scroll = max(0, min(max_scroll, self.inventory_scroll))

                if event.type == pygame.MOUSEBUTTONDOWN:
                    m_pos = event.pos
                    if self.state == 'INVENTORY':
                        clicked_fav = False
                        for fish_ref, btn_rect in self.inventory_favorite_buttons:
                            if btn_rect.collidepoint(m_pos):
                                fish_ref["favorited"] = not fish_ref.get("favorited", False)
                                if fish_ref["favorited"]:
                                    self.show_toast("Peixe favoritado!")
                                else:
                                    self.show_toast("Peixe desfavoritado!")
                                self.save_game()
                                clicked_fav = True
                                break
                        
                        if not clicked_fav:
                            ix, iy = SCREEN_WIDTH // 2 - 230, SCREEN_HEIGHT // 2 - 200
                            inv_rect = pygame.Rect(ix, iy, 460, 400)
                            if inv_rect.collidepoint(m_pos):
                                self.is_dragging_inventory = True
                                self.inventory_touch_start_y = m_pos[1]

                    if self.state == 'SHOP':
                        self.handle_shop_click(m_pos)
                    elif self.state == 'INVENTORY':
                        ix, iy = SCREEN_WIDTH // 2 - 230, SCREEN_HEIGHT // 2 - 200
                        close_btn = pygame.Rect(ix + 420, iy + 10, 30, 30)
                        if close_btn.collidepoint(m_pos) or self.btn_inv.collidepoint(m_pos):
                            self.state = 'EXPLORING'
                            self.is_dragging_inventory = False
                    elif self.state == 'BESTIARY':
                        bx, by = SCREEN_WIDTH // 2 - 380, SCREEN_HEIGHT // 2 - 230
                        bw, bh = 760, 460
                        close_btn = pygame.Rect(bx + bw - 40, by + 10, 30, 30)
                        btn_prev = pygame.Rect(bx + 20, by + bh - 40, 110, 30)
                        btn_next = pygame.Rect(bx + bw - 130, by + bh - 40, 110, 30)

                        if close_btn.collidepoint(m_pos) or self.btn_bestiary.collidepoint(m_pos):
                            self.state = 'EXPLORING'
                        elif btn_prev.collidepoint(m_pos):
                            self.bestiary_page = max(0, self.bestiary_page - 1)
                        elif btn_next.collidepoint(m_pos):
                            max_pages = len(ISLANDS) + 1
                            self.bestiary_page = min(max_pages - 1, self.bestiary_page + 1)
                    elif self.state == 'RESULT':
                        self.interact()
                    else:
                        if self.btn_inv.collidepoint(m_pos):
                            self.state = 'INVENTORY'
                            self.inventory_scroll = 0
                        elif self.btn_bestiary.collidepoint(m_pos):
                            self.state = 'BESTIARY'
                        elif self.btn_action.collidepoint(m_pos):
                            self.interact()

                if event.type == pygame.MOUSEMOTION:
                    if self.state == 'INVENTORY' and self.is_dragging_inventory:
                        m_pos = event.pos
                        dy = m_pos[1] - self.inventory_touch_start_y
                        if abs(dy) > 25:
                            steps = int(abs(dy) / 25)
                            max_scroll = max(0, len(self.player.inventory) - 9)
                            if dy > 0:
                                self.inventory_scroll = max(0, self.inventory_scroll - steps)
                            else:
                                self.inventory_scroll = min(max_scroll, self.inventory_scroll + steps)
                            self.inventory_touch_start_y = m_pos[1]

                if event.type == pygame.MOUSEBUTTONUP:
                    if event.button == 1:
                        self.is_dragging_inventory = False

            if self.state == 'EXPLORING':
                # Combina entrada do teclado (W, A, S, D ou setas) com o Joystick analógico
                dx = (1 if keys[pygame.K_d] or keys[pygame.K_RIGHT] else 0) - \
                     (1 if keys[pygame.K_a] or keys[pygame.K_LEFT] else 0)
                dy = (1 if keys[pygame.K_s] or keys[pygame.K_DOWN] else 0) - \
                     (1 if keys[pygame.K_w] or keys[pygame.K_UP] else 0)
                
                if dx == 0 and dy == 0 and self.joystick_active:
                    dx, dy = self.joystick_vector[0], self.joystick_vector[1]

                self.player.move(dx, dy, (WORLD_WIDTH, WORLD_HEIGHT))
                self.camera.update((self.player.x, self.player.y))

            elif self.state == 'WAITING_BITES':
                if pygame.time.get_ticks() >= self.wait_timer:
                    self.start_minigame()

            elif self.state == 'MINIGAME':
                action_held = keys[pygame.K_SPACE] or self.touch_action
                self.update_minigame(action_held)

            for p in self.particles[:]:
                p.update()
                if p.lifetime <= 0: self.particles.remove(p)

            for ft in self.floating_texts[:]:
                ft.update()
                if ft.lifetime <= 0: self.floating_texts.remove(ft)

            self.draw()

        pygame.quit()

