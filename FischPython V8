    def check_masterline_unlock(self):
        if "masterline" in self.player.unlocked_rods:
            return

        all_species = get_all_game_species()
        all_rods = get_all_game_rods()
        all_boats = set(BOATS.keys())

        bestiary_done = all_species.issubset(set(self.player.bestiary.keys()))
        rods_done = all_rods.issubset(set(self.player.unlocked_rods))
        boats_done = all_boats.issubset(set(self.player.unlocked_boats))
        level_done = self.player.level >= 100
        coins_done = self.player.coins >= 5000000

        if bestiary_done and rods_done and boats_done and level_done and coins_done:
            if "masterline" not in self.player.unlocked_rods:
                self.player.unlocked_rods.append("masterline")
