def get_all_game_species():
    species = set()
    for isl in ISLANDS.values():
        for lk in isl["lakes"].values():
            for r_list in lk["fish"].values():
                for fish_name in r_list:
                    species.add(fish_name)
    species.add("Eclipse Ancient Serpent")
    return species

def get_all_game_rods():
    rods = set()
    for isl in ISLANDS.values():
        for r_key in isl["rods"].keys():
            rods.add(r_key)
    return rods

class Camera:
    def __init__(self, width, height):
        self.camera = pygame.Rect(0, 0, width, height)
        self.width = width
        self.height = height

    def apply(self, target):
        if isinstance(target, pygame.Rect):
            return target.move(self.camera.topleft)
        return target[0] + self.camera.x, target[1] + self.camera.y

    def update(self, target_pos):
        x = -target_pos[0] + int(SCREEN_WIDTH / 2)
        y = -target_pos[1] + int(SCREEN_HEIGHT / 2)

        x = min(0, max(-(self.width - SCREEN_WIDTH), x))
        y = min(0, max(-(self.height - SCREEN_HEIGHT), y))
        self.camera = pygame.Rect(x, y, self.width, self.height)

class Particle:
    def __init__(self, x, y, color, vx=None, vy=None, size=None, lifetime=25):
        self.x = x
        self.y = y
        self.color = color
        self.vx = vx if vx is not None else random.uniform(-3, 3)
        self.vy = vy if vy is not None else random.uniform(-3, 3)
        self.size = size if size is not None else random.randint(3, 7)
        self.lifetime = lifetime

    def update(self):
        self.x += self.vx
        self.y += self.vy
        self.lifetime -= 1

    def draw(self, surface, camera):
        if self.lifetime > 0:
            cx, cy = camera.apply((self.x, self.y))
            pygame.draw.circle(surface, self.color, (int(cx), int(cy)), self.size)

class FloatingText:
    def __init__(self, x, y, text, color):
        self.x = x
        self.y = y
        self.text = text
        self.color = color
        self.lifetime = 40

    def update(self):
        self.y -= 1.5
        self.lifetime -= 1

    def draw(self, surface, camera):
        if self.lifetime > 0:
            cx, cy = camera.apply((self.x, self.y))
            lbl = font_medium.render(self.text, True, self.color)
            surface.blit(lbl, (cx - lbl.get_width() // 2, cy))

class Player:
    def __init__(self, x, y):
        self.x = float(x)
        self.y = float(y)
        self.base_speed = 7.0
        self.radius = 16
        self.coins = 150
        self.level = 1
        self.xp = 0
        self.xp_next = 70
        
        self.equipped_rod = "bambu"
        self.unlocked_rods = ["bambu"]
        
        self.equipped_boat = "pe"
        self.unlocked_boats = ["pe"]
        
        self.equipped_bait = "minhoca"
        self.baits_stock = {"camarao": 0, "brilhante": 0}

        self.inventory = []
        self.bestiary = {}
        self.is_in_water = False

    def add_xp(self, amount, game):
        self.xp += amount
        game.add_floating_text(self.x, self.y - 30, f"+{amount} XP", CYAN)
        while self.xp >= self.xp_next:
            self.xp -= self.xp_next
            self.level += 1
            self.xp_next = int(self.xp_next * 1.175)
            game.show_toast(f" SUBIU PARA O NÍVEL {self.level}! ")
            game.spawn_sparkles(self.x, self.y, GOLD, 20)

    def get_rect(self, x=None, y=None):
        px = self.x if x is None else x
        py = self.y if y is None else y
        return pygame.Rect(px - self.radius, py - self.radius, self.radius * 2, self.radius * 2)

    def check_on_land(self, rect):
        for isl in ISLANDS.values():
            if isl["rect"].colliderect(rect):
                in_lake = False
                for lk in isl["lakes"].values():
                    if lk["rect"].colliderect(rect):
                        in_lake = True
                        break
                if not in_lake:
                    return True
        return False

    def move(self, dx, dy, world_bounds):
        if dx == 0 and dy == 0:
            return

        if self.equipped_boat != "pe":
            speed = self.base_speed * BOATS[self.equipped_boat]["speed_mult"]
        else:
            speed = self.base_speed

        next_x = max(20, min(world_bounds[0] - 20, self.x + dx * speed))
        next_y = max(20, min(world_bounds[1] - 20, self.y + dy * speed))

        test_rect_x = self.get_rect(x=next_x, y=self.y)
        land_x = self.check_on_land(test_rect_x)
        
        if self.equipped_boat == "pe":
            if land_x:
                self.x = next_x
        else:
            self.x = next_x

        test_rect_y = self.get_rect(x=self.x, y=next_y)
        land_y = self.check_on_land(test_rect_y)
        
        if self.equipped_boat == "pe":
            if land_y:
                self.y = next_y
        else:
            self.y = next_y

        self.is_in_water = not self.check_on_land(self.get_rect())

    def draw(self, surface, camera, game_instance):
        cx, cy = camera.apply((self.x, self.y))
        
        if self.equipped_boat != "pe":
            if self.equipped_boat == "bote":
                pygame.draw.ellipse(surface, (139, 69, 19), (cx - 24, cy - 14, 48, 28))
                pygame.draw.ellipse(surface, (100, 40, 10), (cx - 24, cy - 14, 48, 28), 3)
            elif self.equipped_boat == "speedboat":
                pygame.draw.polygon(surface, WHITE, [(cx + 28, cy), (cx - 22, cy - 16), (cx - 18, cy), (cx - 22, cy + 16)])
                pygame.draw.polygon(surface, RED, [(cx + 28, cy), (cx - 22, cy - 16), (cx - 18, cy), (cx - 22, cy + 16)], 2)

        pygame.draw.circle(surface, (255, 220, 177), (int(cx), int(cy - 8)), 9)
        pygame.draw.line(surface, BLACK, (cx, cy), (cx, cy + 12), 3)
        
        rod_data = game_instance.get_rod_data(self.equipped_rod)
        rod_color = rod_data.get("color", GOLD)
        decor = rod_data.get("decor", "bambu")

        tip_x, tip_y = cx + 24, cy - 18
        base_hx, base_hy = cx, cy + 2

        pygame.draw.line(surface, rod_color, (base_hx, base_hy), (tip_x, tip_y), 3)

        if decor == "bambu":
            pygame.draw.line(surface, (80, 50, 20), (cx + 8, cy - 4), (cx + 12, cy - 8), 2)
