    def get_rod_data(self, rod_key):
        if rod_key == "masterline":
            return MASTERLINE_ROD
        for isl in ISLANDS.values():
            if rod_key in isl["rods"]:
                return isl["rods"][rod_key]
        return ISLANDS["inicial"]["rods"]["bambu"]

    def get_random_fish(self, lake_data):
        if self.is_eclipse_fishing and self.eclipse_guaranteed_catch:
            self.eclipse_guaranteed_catch = False
            info = FISH_RARITY_INFO["Divina"]
            base_price = info["price"]
        else:
            rod_data = self.get_rod_data(self.player.equipped_rod)
            bait_data = BAITS[self.player.equipped_bait]
            weather_info = WEATHER_TYPES[self.current_weather]

            total_luck = rod_data["luck"] * bait_data["luck_mult"] * weather_info["luck_mult"]

            weights = []
            rarities = [r for r in FISH_RARITY_INFO.keys() if r != "Divina"]
            for r in rarities:
                base_chance = FISH_RARITY_INFO[r]["chance"]
                if r in ["Raro", "Épico", "Lendário", "Mítico", "SECRETO"]:
                    weights.append(base_chance * total_luck)
                else:
                    weights.append(base_chance)

            available_rarities = [r for r in rarities if r in lake_data["fish"] and len(lake_data["fish"][r]) > 0]
            if not available_rarities:
                available_rarities = ["Comum"]

            filtered_rarities = []
            filtered_weights = []
            for r in available_rarities:
                idx = rarities.index(r)
                filtered_rarities.append(r)
                filtered_weights.append(weights[idx])

            chosen_rarity = random.choices(filtered_rarities, weights=filtered_weights, k=1)[0]
            
            if self.player.equipped_bait != "minhoca":
                self.player.baits_stock[self.player.equipped_bait] = max(0, self.player.baits_stock[self.player.equipped_bait] - 1)
                if self.player.baits_stock[self.player.equipped_bait] <= 0:
                    self.player.equipped_bait = "minhoca"
                    self.show_toast("Sua isca acabou! Voltando para Minhoca.")

            available_species = lake_data["fish"].get(chosen_rarity, [])
            if not available_species:
                available_species = ["Peixe Abissal Misterioso"]

            name = random.choice(available_species)
            info = FISH_RARITY_INFO[chosen_rarity]
            
            weight = round(random.uniform(1.0, 40.0 if chosen_rarity not in ["Mítico", "SECRETO"] else 250.0), 2)
            base_price = int(info["price"] * (weight / 5.0) + info["price"] * 0.2)

            # Aplicação do multiplicador de dinheiro da ilha atual
            if self.active_island and self.active_island in ISLANDS:
                base_price = int(base_price * ISLANDS[self.active_island].get("money_buff", 1.0))

            lake_level = lake_data.get("req_level", 1)
            if lake_level >= 50:
                area_xp_multiplier = 1.0 + (lake_level * 1.8)
            elif lake_level >= 30:
                area_xp_multiplier = 1.0 + (lake_level * 1.2)
            else:
                area_xp_multiplier = 1.0 + (lake_level * 0.65)
                
            scaled_xp = int(info["xp"] * area_xp_multiplier)

            fish_result = {
                "name": name,
                "rarity": chosen_rarity,
                "weight": weight,
                "price": base_price,
                "xp": scaled_xp,
                "color": info["color"],
                "speed": info["speed"],
                "lake": lake_data["name"],
                "favorited": False,
                "is_shiny": False,
                "is_sparkling": False
            }
            
            is_shiny = random.random() < 0.01
            is_sparkling = random.random() < 0.03

            fish_result["is_shiny"] = is_shiny
            fish_result["is_sparkling"] = is_sparkling

            final_price = float(base_price)
            if is_shiny:
                final_price *= 2.0
            if is_sparkling:
                final_price *= 1.5
            
            fish_result["price"] = int(final_price)
            return fish_result

        weight = round(random.uniform(250.0, 800.0), 2)
        is_shiny = random.random() < 0.01
        is_sparkling = random.random() < 0.03
        final_price = float(base_price)
        if self.active_island and self.active_island in ISLANDS:
            final_price *= ISLANDS[self.active_island].get("money_buff", 1.0)
        if is_shiny: final_price *= 2.0
        if is_sparkling: final_price *= 1.5

        return {
            "name": "Eclipse Ancient Serpent",
            "rarity": "Divina",
            "weight": weight,
            "price": int(final_price),
            "xp": info["xp"],
            "color": info["color"],
            "speed": info["speed"],
            "lake": "Oceano do Eclipse",
            "favorited": False,
            "is_shiny": is_shiny,
            "is_sparkling": is_sparkling
        }

    def start_fishing(self, lake_data, island_key, is_eclipse=False):
        if self.state != 'EXPLORING':
            return

        if not is_eclipse and self.player.level < lake_data["req_level"]:
            self.show_toast(f"Requer Nível {lake_data['req_level']} para pescar aqui!")
            return

        self.active_lake = lake_data
        self.active_island = island_key
        self.is_eclipse_fishing = is_eclipse

        rod_data = self.get_rod_data(self.player.equipped_rod)
        
        if rod_data.get("instant_bite", False):
            self.start_minigame()
        else:
            self.state = 'WAITING_BITES'
            self.wait_timer = pygame.time.get_ticks() + random.randint(1200, 2800)

    def start_minigame(self):
        if self.state not in ('EXPLORING', 'WAITING_BITES'):
            return
        self.state = 'MINIGAME'
        self.current_fish = self.get_random_fish(self.active_lake)
        self.perfect_catch = True
        
        self.fish_pos = self.track_width / 2
        rod_data = self.get_rod_data(self.player.equipped_rod)
        bar_size = rod_data["bar_size"]
        self.bar_pos = (self.track_width - bar_size) / 2
        self.bar_vel = 0
        self.progress = 35.0
        self.fish_target = random.randint(20, self.track_width - 20)

    def update_minigame(self, action_held):
        if self.state != 'MINIGAME' or not self.current_fish:
            return

        info = self.current_fish
        rod_data = self.get_rod_data(self.player.equipped_rod)
        bar_size = rod_data["bar_size"]

        resilience = rod_data.get("resilience", 0)
        res_multiplier = max(0.05, 1.0 - (resilience / 100.0))

        if abs(self.fish_pos - self.fish_target) < 15 or random.random() < (0.05 * res_multiplier):
            self.fish_target = random.randint(20, self.track_width - 20)

        dir_x = 1 if self.fish_target > self.fish_pos else -1
        effective_speed = (info["speed"] * 0.85) * res_multiplier
        self.fish_pos += dir_x * effective_speed
        self.fish_pos = max(10, min(self.track_width - 10, self.fish_pos))

        if action_held:
            self.bar_vel += 3.2
        else:
            self.bar_vel -= 3.2

        self.bar_vel = max(-15.0, min(15.0, self.bar_vel))
        self.bar_pos += self.bar_vel
        
        if self.bar_pos < 0:
            self.bar_pos = 0
            self.bar_vel = 0
        elif self.bar_pos > self.track_width - bar_size:
            self.bar_pos = self.track_width - bar_size
            self.bar_vel = 0

        in_zone = self.bar_pos <= self.fish_pos <= (self.bar_pos + bar_size)
        
        # Redução de velocidade de progresso por raridade
        rarity_mult = 1.0
        fish_rarity = info["rarity"]
        if fish_rarity == "Lendário":
            rarity_mult = 0.7   # -30%
        elif fish_rarity == "Mítico":
            rarity_mult = 0.4   # -60%
        elif fish_rarity == "SECRETO":
            rarity_mult = 0.3   # -70%
        elif fish_rarity == "Divina":
            rarity_mult = 0.25  # -75%

        prog_speed = 1.4 * rod_data.get("progress_mult", 1.0) * rarity_mult

        if in_zone:
            self.progress += prog_speed
            if random.random() < 0.2:
                self.particles.append(Particle(SCREEN_WIDTH // 2 - self.track_width // 2 + self.fish_pos, SCREEN_HEIGHT // 2, info["color"], lifetime=10))
        else:
            self.progress -= 0.8
            self.perfect_catch = False

        self.progress = max(0, min(100, self.progress))

        if self.progress >= 100:
            self.state = 'RESULT'
            
            if self.perfect_catch:
                self.current_fish["xp"] = int(self.current_fish["xp"] * 1.5)
                self.show_toast("CAPTURA PERFEITA! 1.5x XP!")

            self.caught_fish = self.current_fish
            self.player.inventory.append(self.current_fish)
            self.player.add_xp(self.current_fish["xp"], self)
            
            fname = self.current_fish["name"]
            if fname not in self.player.bestiary:
                self.player.bestiary[fname] = {"caught": 0, "max_weight": 0, "rarity": self.current_fish["rarity"]}
            self.player.bestiary[fname]["caught"] += 1
            self.player.bestiary[fname]["max_weight"] = max(self.player.bestiary[fname]["max_weight"], self.current_fish["weight"])
            self.player.bestiary[fname]["rarity"] = self.current_fish["rarity"]

            self.spawn_sparkles(self.player.x, self.player.y, self.current_fish["color"], 25)
            self.check_masterline_unlock()
            self.save_game()
            self.is_eclipse_fishing = False

        elif self.progress <= 0:
            self.state = 'RESULT'
            self.caught_fish = None
            self.is_eclipse_fishing = False

    def interact(self):
        if self.state in ('SHOP', 'INVENTORY', 'BESTIARY', 'RESULT'):
            if self.state == 'RESULT':
                self.caught_fish = None
            self.state = 'EXPLORING'
            return

        p_rect = self.player.get_rect()

        if self.state == 'EXPLORING':
            if self.current_weather == "Eclipse" and self.eclipse_zone:
                if p_rect.colliderect(self.eclipse_zone):
                    fake_eclipse_lake = {
                        "name": "Linha Divina do Eclipse",
                        "req_level": 1,
                        "color": RED,
                        "fish": {
                            "Mítico": ["Ser do Vazio"],
                            "SECRETO": ["Abismo Vivo"]
                        }
                    }
                    self.start_fishing(fake_eclipse_lake, None, is_eclipse=True)
                    return

            for isl_key, isl in ISLANDS.items():
                for lake_key, lake in isl["lakes"].items():
                    if p_rect.colliderect(lake["rect"].inflate(20, 20)):
                        self.start_fishing(lake, isl_key)
                        return

                if p_rect.colliderect(isl["vendor_npc"].inflate(30, 30)):
                    if not self.player.inventory:
                        self.show_toast("Você não tem peixes para vender!")
                    else:
                        unfavorited_fish = [f for f in self.player.inventory if not f.get("favorited", False)]
